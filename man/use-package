;;; use-package --- Hyperbole use-package reference configuration   -*- mode: emacs-lisp; lexical-binding: t; -*-

;; NOTE: If you use Emacs 28 or earlier, you'll need to install the
;; `use-package' Emacs package before using this configuration file
;; since it is not built-in to your Emacs.

;; -----------------------------------------------------------------

;; Default values herein represent the settings Hyperbole will default
;; to if not set within this `use-package' configuration.
(use-package hyperbole

  :config
  ;; Hyperbole binds {C-h h} in the `global-map' to display its
  ;; minibuffer command menus. If you prefer a different binding,
  ;; uncomment the two lines below which restore the standard binding
  ;; for {C-h h} and set your preferred binding: example {C-c h}.
  ;;   (global-set-key (kbd "C-h h") #'view-hello-file)
  ;;   (global-set-key (kbd "C-c h") #'hyperbole)

  :init
  ;; Enable or disable the global Hyperbole minor mode on startup:
  ;;   1 - enabled after Hyperbole is loaded so the Action and
  ;;       Assist Smart Keys are active
  ;;
  ;;   0 - off (default)
  (hyperbole-mode 1)

  ;; Initialize the global HyWiki minor mode to one of these values:
  ;; - :all   - highlight HyWikiWords in all editable buffers except those
  ;;            with a major mode in ‘hypb:exclude-major-modes’; also
  ;;            enable ‘hyperbole-mode’ minor mode if off.
  ;;
  ;; - :pages - highlight HyWikiWords in HyWiki pages only (Org files in
  ;;            ‘hywiki-directory’); also enable ‘hyperbole-mode’ minor mode
  ;;            if off. (default)
  ;;
  ;; - nil    - no highlighting, the ‘hywiki-mode’ is disabled.
  (hywiki-mode :all)

  :bind
  (:map hyperbole-mode-map
	;; Bind Smart Keys: {M-RET} executes `action-key' and {C-u M-RET}
	;; executes `assist-key' via this next binding
	("M-RET" . hkey-either))

  :custom
  ;; Action and Assist Key Customizations

  ;; Customize how Hyperbole and Org mode share the M-RET key:
  ;;   t        - With `hyperbole-mode' enabled, Hyperbole controls the key.
  ;;
  ;;   'buttons - With `hyperbole-mode enabled', Hyperbole controls the key
  ;;              only when on a button or link; otherwise, Org controls
  ;;              it. (default)
  ;;
  ;;   nil      - In Org mode, Org controls the key.
  (hsys-org-enable-smart-keys t)

  ;; HyWiki Customizations

  ;; Directory to store all HyWiki pages in (default = "~/hywiki/")
  (hywiki-directory "~/hywiki/")

  ;; Koutliner Customizations

  ;; NOTE: As of Hyperbole version 9.3.0, the Koutliner uses `C-c ;'
  ;; as the prefix for mode-specific <letter> key bindings (prior
  ;; prefix was `C-c'); this avoids overriding global user settings of
  ;; `C-c <letter>'.
  ;;
  ;; If you want the prior Koutline-specific letter key bindings
  ;; instead of the current ones, uncomment the following line:
  ;; (kotl-mode:letter-prefix "C-c")

  ;; Customize the behavior of the <tab> and S-<tab> keys in a Koutline.
  ;; One of three possible values:
  ;;   nil      - {TAB} demotes the current tree and {Shift-TAB} promotes the
  ;;              tree. (default)
  ;;
  ;;   'cycle  -  enables Org-like outline view cycling when point is in
  ;;              a context other than that specified by ‘org-cycle-emulate-tab’.
  ;;              See {C-h f kotl-mode:tab-command RET} for details.
  ;;
  ;;   t       -  makes {TAB} indent lines and insert literal <tab> characters
  ;;              according to the context setting of ‘kotl-mode:emulate-tab’,
  ;;              which also determines where {Shift-TAB} deletes backward.
  (kotl-mode:tab-flag nil)

  ;; Setup contexts where ‘kotl-mode:tab-command’ should override
  ;; `kotl-mode:tab-flag' and run ‘kotl-mode:indent-line’, often
  ;; inserting a <tab> character.
  ;; Potential values are:
  ;;   nil         - Never
  ;;
  ;;   white       - Only in completely white lines
  ;;
  ;;   whitestart  - Only at the beginning of lines, before the first non-white char
  ;;
  ;;   t           - Everywhere except in headlines
  ;;
  ;;   exc-hl-bol  - Everywhere except at the start of a headline
  (kotl-mode:emulate-tab nil)

  ;; Configure whether `kotl-mode:indent-line' uses tabs and spaces or
  ;; spaces only.
  ;; Potential values are:
  ;;   t   - may insert literal <tab> characters. (default)
  ;;
  ;;   nil - may insert <spc> characters only.
  (kotl-mode:indent-tabs-mode t)

  ;; Prior to the addition of Org-style visibility cycling to the
  ;; Koutliner on the TAB key, a press of the Action Key on a Koutline
  ;; cell line used to toggle showing/hiding the tree rooted at point.
  ;; Today, this does nothing.
  ;;
  ;; Uncomment the next expression if you prefer the prior behavior
  ;; but note that if `hywiki-mode' is set to `:all' when point is on
  ;; a capitalized word, an Action Key press will create a new HyWiki
  ;; page, as that has higher priority than this setting.
  ;;
  ;; (kotl-mode:action-key-default-function 'kotl-mode:show-or-hide-tree)
  )
